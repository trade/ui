# ─────────────────────────────────────────────────────────────
# @trade/ui — project UI
# Nothing here is hand-edited. Every ignored path is regenerated:
#   npm run build            → packages/*/dist
#   npm run demo             → apps/demo/dist
#   npm run harness          → harness/dist
#   npm run verify / verify:browser → verification/*.json
# ─────────────────────────────────────────────────────────────

# dependencies
node_modules/
.pnpm-store/

# build output
dist/
packages/*/dist/
build/
*.tsbuildinfo
*.tsbuildinfo.*

# generated demo + harness bundles
apps/*/dist/
harness/dist/

# generated verification reports (regenerated on every verify run)
verification/*.json
harness/results.json

# regenerated browser screenshots — evidence, not baselines. They change on EVERY suite run
# and are uploaded as CI artifacts. Visual regression compares against the COMMITTED
# baselines/<platform>/ directory, which the suite reads but never writes (regenerate only
# via `npm run baselines:update`).
verification/screenshots/

# playwright
test-results/
playwright-report/
blob-report/
.playwright/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# env & secrets — never commit these
.env
.env.*
!.env.example

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# caches
.cache/
.eslintcache
.turbo/
.parcel-cache/
coverage/

# orphaned screenshot folder from an earlier suite layout; nothing generates it
verification/screen/

# licence files copied into each publishable package by `prepack` (scripts/copy-licenses.mjs);
# they exist only so `npm pack`/publish ships the terms, and are regenerated from the root copies
packages/*/LICENSE
packages/*/LICENSE-MIT
packages/*/LICENSE-APACHE
packages/*/NOTICE
