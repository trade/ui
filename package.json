{
  "name": "ui",
  "private": true,
  "version": "0.1.0",
  "description": "Project UI — @trade/ui component system (static CSS, light/dark/high-contrast themes, non-animated)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @trade/tokens && npm run build --workspace @trade/ui",
    "verify": "node scripts/verify.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:style": "node scripts/check-style.mjs",
    "check:docs": "node scripts/check-docs-links.mjs",
    "check:commits": "node scripts/check-commits.mjs",
    "verify:demo": "node scripts/verify-demo.mjs",
    "verify:browser": "node scripts/browser-suite.mjs",
    "baselines:update": "node scripts/browser-suite.mjs --update-baselines",
    "size": "size-limit",
    "harness:build": "node scripts/build-harness.mjs",
    "harness": "node scripts/build-harness.mjs && node scripts/serve.mjs",
    "demo": "node scripts/build-demo.mjs",
    "screen:build": "node scripts/build-trading.mjs",
    "verify:screen": "node scripts/verify-screen.mjs",
    "all": "npm run build && npm run demo && npm run harness:build && npm run verify && npm run verify:demo && npm run verify:browser",
    "ci": "npm run check:contract && npm run build && npm run check:contrast && npm run check:style && npm run check:docs && npm run check:commits && npm run demo && npm run harness:build && npm run size && npm run verify && npm run verify:demo && npm run verify:browser"
  },
  "size-limit": [
    {
      "name": "@trade/ui ESM bundle (gzip)",
      "path": "packages/ui/dist/index.js",
      "limit": "8 kB",
      "gzip": true
    },
    {
      "name": "@trade/ui stylesheet (gzip, all components)",
      "path": "packages/ui/dist/ui.css",
      "limit": "8 kB",
      "gzip": true
    },
    {
      "name": "@trade/ui generated types",
      "path": "packages/ui/dist/index.d.ts",
      "limit": "3 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@size-limit/file": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^14.0.0",
    "typescript": "^5.6.0"
  }
}
