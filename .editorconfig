# Matches the repository conventions: 2-space indent, LF, UTF-8, no trailing whitespace.
# `engines` in package.json and `.nvmrc` are the authority for the toolchain version.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml,toml}]
indent_size = 2

[Makefile]
indent_style = tab
