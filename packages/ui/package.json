{
  "name": "@trade/ui",
  "version": "0.1.0",
  "description": "React components for dense, data-heavy interfaces. Static CSS, light/dark/high-contrast themes, no animation, zero runtime dependencies.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/ui.css",
    "./components/*": "./dist/components/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {},
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node ../../scripts/copy-licenses.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trade/ui.git",
    "directory": "packages/ui"
  },
  "license": "MIT OR Apache-2.0"
}
