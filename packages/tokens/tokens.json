{
  "$schema": "https://trade/ui/tokens.schema.json",
  "name": "UI",
  "package": "@trade/ui",
  "version": "0.2.0",
  "description": "Design tokens for @trade/ui. Primitive = raw values we own. Theme = roles mapped to primitives by reference. Components only ever read roles.",

  "primitive": {
    "colour": {
      "neutral": {
        "0": "#ffffff",
        "25": "#fafafa",
        "35": "#f6f6f6",
        "50": "#f5f5f5",
        "100": "#eeeeee",
        "150": "#e8e8e8",
        "200": "#dadce0",
        "300": "#bdbdbd",
        "400": "#9e9e9e",
        "500": "#757575",
        "600": "#616161",
        "700": "#424242",
        "750": "#3a3a3a",
        "800": "#212121",
        "850": "#1e1e1e",
        "875": "#181818",
        "900": "#121212",
        "950": "#0a0a0a",
        "1000": "#000000"
      },
      "indigo": { "200": "#9fa8da", "500": "#3f51b5", "700": "#303f9f" },
      "teal": { "200": "#80cbc4", "500": "#009688", "700": "#00796b" },
      "green": { "400": "#4caf50", "600": "#0a7d46", "700": "#0a5c33" },
      "red": { "400": "#ef5350", "600": "#c62828", "700": "#a31515" },
      "amber": { "300": "#fdd663", "600": "#f9ab00", "700": "#a05f00", "800": "#7a5200" },
      "blue": { "300": "#8ab4f8", "600": "#1a73e8", "800": "#0b4fa8" }
    },
    "alpha": {
      "scrim": { "light": "rgba(0, 0, 0, 0.48)", "dark": "rgba(0, 0, 0, 0.62)", "highContrast": "rgba(0, 0, 0, 0.80)" },
      "hover": { "light": "rgba(0, 0, 0, 0.06)", "dark": "rgba(255, 255, 255, 0.08)", "highContrast": "rgba(0, 0, 0, 0.14)" }
    },
    "space": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "64px"
    },
    "radius": { "sm": "2px", "md": "4px", "lg": "8px", "pill": "999px" },
    "font": {
      "family": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "numeric": "'SF Mono', 'Roboto Mono', ui-monospace, monospace",
      "size": { "2xs": "10px", "xs": "11px", "sm": "12px", "md": "14px", "lg": "16px", "xl": "20px", "2xl": "24px" },
      "lineHeight": { "2xs": "14px", "xs": "16px", "sm": "16px", "md": "20px", "lg": "24px", "xl": "28px", "2xl": "32px" }
    },
    "elevation": {
      "0": "none",
      "1": "0 1px 2px rgba(0,0,0,.14), 0 1px 3px rgba(0,0,0,.12)",
      "2": "0 2px 4px rgba(0,0,0,.14), 0 3px 6px rgba(0,0,0,.10)",
      "4": "0 4px 8px rgba(0,0,0,.15), 0 3px 5px rgba(0,0,0,.10)",
      "8": "0 8px 12px rgba(0,0,0,.16), 0 4px 8px rgba(0,0,0,.12)",
      "16": "0 16px 24px rgba(0,0,0,.18), 0 8px 12px rgba(0,0,0,.12)",
      "24": "0 24px 38px rgba(0,0,0,.20), 0 12px 18px rgba(0,0,0,.12)"
    },
    "zIndex": { "dropdown": 1000, "sticky": 1020, "overlay": 1040, "modal": 1050, "popover": 1060, "toast": 1070 },
    "opacity": { "disabled": "0.5" },
    "density": { "comfortable": 1, "compact": 0.75, "dense": 0.625 },
    "motion": { "enabled": false, "short": "100ms", "medium": "200ms", "long": "300ms" }
  },

  "themes": {
    "light": {
      "primary": "{colour.indigo.500}",
      "onPrimary": "{colour.neutral.0}",
      "secondary": "{colour.teal.700}",
      "onSecondary": "{colour.neutral.0}",
      "error": "{colour.red.600}",
      "onError": "{colour.neutral.0}",
      "background": "{colour.neutral.50}",
      "surface": "{colour.neutral.0}",
      "surface-1": "{colour.neutral.25}",
      "onSurface": "{colour.neutral.800}",
      "onSurfaceMuted": "{colour.neutral.600}",
      "outline": "{colour.neutral.200}",
      "borderControl": "{colour.neutral.500}",
      "positive": "{colour.green.600}",
      "negative": "{colour.red.600}",
      "warning": "{colour.amber.700}",
      "info": "{colour.blue.600}",
      "focusRing": "{colour.blue.600}",
      "rowAlt": "{colour.neutral.35}",
      "scrim": "{alpha.scrim.light}",
      "hoverOverlay": "{alpha.hover.light}"
    },
    "dark": {
      "primary": "{colour.indigo.200}",
      "onPrimary": "{colour.neutral.800}",
      "secondary": "{colour.teal.200}",
      "onSecondary": "{colour.neutral.800}",
      "error": "{colour.red.400}",
      "onError": "{colour.neutral.800}",
      "background": "{colour.neutral.950}",
      "surface": "{colour.neutral.900}",
      "surface-1": "{colour.neutral.850}",
      "onSurface": "{colour.neutral.150}",
      "onSurfaceMuted": "{colour.neutral.400}",
      "outline": "{colour.neutral.750}",
      "borderControl": "{colour.neutral.500}",
      "positive": "{colour.green.400}",
      "negative": "{colour.red.400}",
      "warning": "{colour.amber.300}",
      "info": "{colour.blue.300}",
      "focusRing": "{colour.blue.300}",
      "rowAlt": "{colour.neutral.875}",
      "scrim": "{alpha.scrim.dark}",
      "hoverOverlay": "{alpha.hover.dark}"
    },
    "high-contrast": {
      "primary": "{colour.indigo.700}",
      "onPrimary": "{colour.neutral.0}",
      "secondary": "{colour.teal.700}",
      "onSecondary": "{colour.neutral.0}",
      "error": "{colour.red.700}",
      "onError": "{colour.neutral.0}",
      "background": "{colour.neutral.0}",
      "surface": "{colour.neutral.0}",
      "surface-1": "{colour.neutral.25}",
      "onSurface": "{colour.neutral.1000}",
      "onSurfaceMuted": "{colour.neutral.700}",
      "outline": "{colour.neutral.500}",
      "borderControl": "{colour.neutral.700}",
      "positive": "{colour.green.700}",
      "negative": "{colour.red.700}",
      "warning": "{colour.amber.800}",
      "info": "{colour.blue.800}",
      "focusRing": "{colour.blue.800}",
      "rowAlt": "{colour.neutral.35}",
      "scrim": "{alpha.scrim.highContrast}",
      "hoverOverlay": "{alpha.hover.highContrast}"
    }
  },

  "defaultTheme": "light",
  "cssVariablePrefix": "--ui-"
}
